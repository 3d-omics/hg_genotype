from snakemake.utils import min_version, validate

min_version("8.0.0")

import pandas as pd
import yaml

# Import configuration files
with open("config/params.yml") as f:
    params = yaml.load(f, Loader=yaml.SafeLoader)
with open("config/features.yml") as f:
    features = yaml.load(f, Loader=yaml.SafeLoader)
samples = pd.read_table("config/samples.tsv", comment="#", dtype="str")

validate(features, schema="schemas/features.schema.yaml")
validate(samples, schema="schemas/samples.schema.yaml")


# Generate useful variables
HOST_NAME = features["name"]
SAMPLES = samples["sample_id"].drop_duplicates().values.tolist()
SAMPLE_LIBRARY = samples[["sample_id", "library_id"]].values.tolist()
REGIONS_BED4 = pd.read_table(
    features["regions"],
    dtype="str",
    comment="#",
    names=["chrom", "chromStart", "chromEnd", "name"],
)
REGIONS = REGIONS_BED4.name


wildcard_constraints:
    sample_id="[^/]+",
    library_id="[^/]+",
    region="[^/]+",
    window="[^/]+",
    sample="[^/]+",
    variant_type="SNP|INDEL",


module helpers:
    snakefile:
        github("jlanga/snakehelpers", path="workflow/Snakefile", branch="main")
    config:
        params


use rule * from helpers exclude samtools__stats__bam as helpers__*


include: "rules/folders.smk"
include: "rules/helpers.smk"
include: "rules/reference.smk"
include: "rules/align.smk"
include: "rules/variants.smk"
include: "rules/annotate.smk"
include: "rules/swaps.smk"


rule all:
    """Run the entire pipeline"""
    input:
        rules.reference__all.input,
        rules.align__all.input,
        rules.variants__all.input,
        rules.annotate__all.input,
        rules.swaps__all.input,


rule cache:
    """Generate only the cacheable elements: recompressed inputs and BWA-MEM2 indexes"""
    input:
        rules.reference__recompress__all.input,
        rules.align__bwamem2__index__all.input,
